LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=replace-with-your-litellm-key

# Per SDK attempt, then total per model request (seconds). No automatic SDK retries.
LITELLM_TIMEOUT_SECONDS=300
LITELLM_REQUEST_DEADLINE_SECONDS=330
LITELLM_MAX_RETRIES=0
# Correction retries per executor tool, excluding its initial attempt. Zero disables retries.
AGENT_TOOL_RETRIES=3
# Output budget for all stages; --max-tokens overrides this per request.
# Reasoning models may require 8192 or more.
LITELLM_MAX_OUTPUT_TOKENS=4096

SMARTWEALTH_DB_HOST=127.0.0.1
SMARTWEALTH_DB_PORT=5433
SMARTWEALTH_DB_NAME=smartwealth
SMARTWEALTH_DB_USER=smartwealth
SMARTWEALTH_DB_PASSWORD=smartwealth_local
