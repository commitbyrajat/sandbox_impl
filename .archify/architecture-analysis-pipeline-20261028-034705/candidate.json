  "cards": [
    {
      "dot": "cyan",
      "title": "Chain of responsibility",
      "items": [
        "Resolve -> classify -> plan -> publish -> load -> execute -> summarize.",
        "Each handler forwards a request-local context to its successor.",
        "Injected service adapters and stages can be replaced independently."
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution conditions",
      "items": [
        "Plan JSON is published before data access; publication failure stops the chain.",
        "SQL-only plans do not start Monty. No-execution plans skip loading and execution.",
        "Preview requests stop after classification, planning or publication."
      ]
    },
    {
      "dot": "rose",
      "title": "DataFusion is outside Monty",
      "items": [
        "DataFusion and Psycopg execute in the host Python process.",
        "Monty receives complete typed rows; it has no database or filesystem access.",
        "The host passes Python outputs and SQL rows to the final summarizer."
      ]
    },
    {
      "dot": "violet",
      "title": "Domain and model mapping",
      "items": [
        "Tenant 1: qwen-coder; workspace 1: credit cards.",
        "Tenant 2: ornith-reasoner; workspace 2: SmartWealth.",
        "All four model roles use the tenant model and their own domain instructions."
      ]
    },
    {
      "dot": "slate",
      "title": "Local source evidence",
      "items": [
        "The workspace has no commits or remote; citations use a separate local snapshot.",
        "See source-provenance.json for the snapshot revision and copied file list.",
        "Summary uses evidence and configured tone; it has no data or code tools."
      ]
    }
  ]
