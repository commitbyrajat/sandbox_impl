  "cards": [
    {
      "dot": "cyan",
      "title": "Resolve: ownership and model",
      "items": [
        "Input: question, tenant ID, workspace ID and optional token override.",
        "Validate workspace ownership and domain profile before model/data access.",
        "Output: RequestScope and tenant-selected model; no domain inference or queries."
      ]
    },
    {
      "dot": "violet",
      "title": "Classify: what the user needs",
      "items": [
        "Input: question and trusted workspace description/glossary.",
        "Split ready and ambiguous objectives; classify business intent only.",
        "Output: QuestionIntent; do not choose sources or tools. Classify mode returns here."
      ]
    },
    {
      "dot": "cyan",
      "title": "Plan: how to serve the intent",
      "items": [
        "Input: intent, source catalog and scoped domain guidance.",
        "Choose SQL or SQL + Python; preserve deferred questions and validation checks.",
        "Consolidate adjacent Python steps; output a scope-validated ExecutionPlan. Plan API mode stops here."
      ]
    },
    {
      "dot": "emerald",
      "title": "Publish: make execution reviewable",
      "items": [
        "Input: question, intent and validated plan.",
        "Write owner-only plan JSON under artifacts/plans/tenant-*/workspace-* and print the approach.",
        "Output: artifact path. Publication failure prevents source loading; CLI --plan-only stops here."
      ]
    },
    {
      "dot": "emerald",
      "title": "Load: prepare authorized sources",
      "items": [
        "Input: resolved scope and selected source IDs. Skip loading for a no-execution plan.",
        "Register scoped Parquet directly; load PostgreSQL via Psycopg/Arrow in a read-only consistent snapshot.",
        "Output: DataSources backed by host DataFusion. No SQL or database runs inside Monty."
      ]
    },
    {
      "dot": "amber",
      "title": "Execute: complete planned work",
      "items": [
        "Input: question, plan, scoped sources and mapped model.",
        "Enforce schema -> SQL -> optional Python step order; failures leave steps pending for correction.",
        "SQL stays read-only and scoped; Python receives complete, untruncated typed rows only.",
        "Prepare code: validate names and input use, supply missing Decimal import, normalize final print.",
        "Reuse matching successful calculations; otherwise run Monty with zero external suspensions.",
        "Output: SQL rows/queries, non-null Python values and completed step IDs. No-execution plans skip tools."
      ]
    },
    {
      "dot": "violet",
      "title": "Summarize: explain verified evidence",
      "items": [
        "Input: question, plan, actual execution evidence and scoped vocabulary/tone.",
        "Hybrid results must contain non-null Python outputs; summary has no tools.",
        "Validate numeric/date claims, configured safe sums, topic scope and policy claims; request corrections on failure.",
        "Output: concise business answer; append deferred clarification questions once. Without execution, return the plan response without a model call."
      ]
    },
    {
      "dot": "rose",
      "title": "Lifecycle and failure rules",
      "items": [
        "These are pipeline stages, not a persisted agent state machine. A request-local context carries their outputs.",
        "Every visited stage emits start/end logs, status and elapsed time, including failures and cancellation.",
        "Any unrecovered stage error stops successor execution; the illustrated failure branch shows executor retry exhaustion.",
        "Preview exits return before source loading. Model budgets apply per request; --max-tokens overrides are reset on exit."
      ]
    }
  ]
}
